{% extends 'base.html.twig' %}

{% block title %}Game index{% endblock %}

{% block body %}
    <h1 class="page-title">Game index</h1>

    <div class="game-panel">
        <div class="table-responsive">
            <table class="table table-striped table-hover game-table align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for game in games %}
                    <tr>
                        <td>{{ game.id }}</td>
                        <td>{{ game.title }}</td>
                        <td>{{ game.description }}</td>
                        <td>
                            <div class="game-actions">
                                <a class="btn btn-sm btn-game-secondary" href="{{ path('app_game_show', {'id': game.id}) }}">show</a>
                                <a class="btn btn-sm btn-game-primary" href="{{ path('app_game_edit', {'id': game.id}) }}">edit</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-game-primary" href="{{ path('app_game_new') }}">Create new</a>
    </div>
{% endblock %}
