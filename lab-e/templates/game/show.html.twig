{% extends 'base.html.twig' %}

{% block title %}Game{% endblock %}

{% block body %}
    <h1 class="page-title">Game</h1>

    <div class="game-panel">
        <dl class="row game-details mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">{{ game.id }}</dd>

            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">{{ game.title }}</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">{{ game.description }}</dd>
        </dl>
    </div>

    <div class="game-actions mt-3">
        <a class="btn btn-game-secondary" href="{{ path('app_game_index') }}">back to list</a>
        <a class="btn btn-game-primary" href="{{ path('app_game_edit', {'id': game.id}) }}">edit</a>
        {{ include('game/_delete_form.html.twig') }}
    </div>
{% endblock %}
